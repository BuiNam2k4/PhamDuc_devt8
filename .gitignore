# ==========================================
# Git Ignore Configuration for Project
# Covers: Python (AI), Node.js (Frontend), Java (Spring Boot), IDE & System
# ==========================================

# ------------------------------------------
# Python & AI / Machine Learning
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# Python Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# AI Model Weights & Heavy Datasets
*.pt
*.pth
*.onnx
*.engine
*.weights
*.pb
*.h5
*.safetensors

# Monitoring & Testing Captures / Reports
test_captures/
performance_report_*.json
runs/

# ------------------------------------------
# Node.js & Web Frontend
# ------------------------------------------
node_modules/
dist/
dist-ssr/
.eslintcache

# NPM / Yarn / PNPM Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Java & Maven (Spring Boot Backend)
# ------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
*.pem
*.key

# ------------------------------------------
# Databases & Logs & Temp Files
# ------------------------------------------
*.db
*.sqlite3
logs/
*.log
temp/
tmp/
*.tmp

